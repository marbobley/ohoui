{% extends 'base.html.twig' %}

{% block title %}Ohoui - Le moteur de recherche français{% endblock %}

{% macro render_doc(doc) %}
    <div class="card mb-3 shadow-sm border-0">
        <div class="card-body p-3">
            <h3 class="h6 mb-1 text-truncate"><a href="{{ doc.getUrl() }}" title="{{ doc.getTitle() }}">{{ doc.getTitle() }}</a></h3>
            <div class="text-success x-small text-truncate mb-2" style="font-size: 0.75rem;">{{ doc.getUrl() }}</div>
            <p class="small mb-2 text-muted">
                {% if doc.getHighlight() %}
                    {{ doc.getHighlight()|raw }}
                {% else %}
                    {{ doc.getContent()|default('')|u.truncate(100, '...') }}
                {% endif %}
            </p>
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-light text-dark border">{{ doc.getLanguage() }}</span>
                    <span class="badge bg-light text-dark border">{{ doc.getDomain() }}</span>
                </div>
                {% if doc.getIndexedAt() %}
                    <small class="text-muted" style="font-size: 0.7rem;">
                        {{ doc.getIndexedAt()|date('d/m/Y') }}
                    </small>
                {% endif %}
            </div>
        </div>
    </div>
{% endmacro %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 mb-4">Ohoui</h1>
            <form action="{{ path('app_home') }}" method="get" class="mb-5">
                <div class="input-group input-group-lg">
                    <input type="text" name="q" class="form-control" placeholder="Rechercher sur le web ouvert..." value="{{ query|default('') }}">
                    <button class="btn btn-primary" type="submit">Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    {% if results is not null %}
        <div class="row">
            <div class="col-12">
                <p class="text-muted">{{ results.totalCount }} résultats trouvés</p>
                <hr>
            </div>
        </div>

        <div class="row">
            {# Colonne 1 : Les plus pertinents #}
            <div class="col-md-4 border-end">
                <h2 class="h4 mb-4 text-primary"><i class="bi bi-star-fill"></i> Les plus pertinents</h2>
                {% for doc in results.getRelevant() %}
                    {{ _self.render_doc(doc) }}
                {% else %}
                    <p class="text-muted">Aucun résultat pertinent.</p>
                {% endfor %}
            </div>

            {# Colonne 2 : Les plus récents #}
            <div class="col-md-4 border-end">
                <h2 class="h4 mb-4 text-success"><i class="bi bi-clock-history"></i> Les plus récents</h2>
                {% for doc in results.getRecent() %}
                    {{ _self.render_doc(doc) }}
                {% else %}
                    <p class="text-muted">Aucun résultat récent.</p>
                {% endfor %}
            </div>

            {# Colonne 3 : Aléatoire #}
            <div class="col-md-4">
                <h2 class="h4 mb-4 text-info"><i class="bi bi-shuffle"></i> Aléatoire</h2>
                {% for doc in results.getRandom() %}
                    {{ _self.render_doc(doc) }}
                {% else %}
                    <p class="text-muted">Aucun résultat aléatoire.</p>
                {% endfor %}
            </div>
        </div>
    {% elseif query is not empty %}
         <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <p>Commencez par indexer des données avec <code>php bin/console app:index-sample</code></p>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
