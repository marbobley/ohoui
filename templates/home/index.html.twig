{% extends 'base.html.twig' %}

{% block title %}Ohoui - Le moteur de recherche français{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 mb-4">Ohoui</h1>
            <form action="{{ path('app_home') }}" method="get" class="mb-5">
                <div class="input-group input-group-lg">
                    <input type="text" name="q" class="form-control" placeholder="Rechercher sur le web ouvert..." value="{{ query|default('') }}">
                    <button class="btn btn-primary" type="submit">Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    {% if results is not null %}
        <div class="row">
            <div class="col-md-3">
                {% if results.facets is not empty %}
                    <div class="card mb-4">
                        <div class="card-header bg-light">Filtres</div>
                        <div class="card-body p-0">
                            {% for facet in results.facets %}
                                <div class="p-3 border-bottom">
                                    <h5 class="h6 mb-3">{{ facet.label }}</h5>
                                    <ul class="list-unstyled mb-0">
                                        {% for value in facet.values %}
                                            {% set is_active = activeFilters[facet.name] is defined and activeFilters[facet.name] == value.value %}
                                            <li class="mb-2">
                                                {% if is_active %}
                                                    <strong>{{ value.value }}</strong> ({{ value.count }})
                                                    <a href="{{ path('app_home', {q: query, filters: activeFilters|filter((v, k) => k != facet.name)}) }}" class="text-danger small ms-1" title="Supprimer le filtre">✕</a>
                                                {% else %}
                                                    <a href="{{ path('app_home', {q: query, filters: activeFilters|merge({(facet.name): value.value})}) }}" class="text-decoration-none">
                                                        {{ value.value }}
                                                    </a>
                                                    <span class="text-muted small">({{ value.count }})</span>
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endfor %}
                            {% if activeFilters is not empty %}
                                <div class="p-3 text-center">
                                    <a href="{{ path('app_home', {q: query}) }}" class="btn btn-sm btn-outline-secondary w-100">Effacer tous les filtres</a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
            <div class="col-md-9">
                <p class="text-muted">{{ results.totalCount }} résultats trouvés</p>
                <hr>
                {% for doc in results.documents %}
                    <div class="mb-4">
                        <h3 class="h5 mb-1"><a href="{{ doc.getUrl() }}">{{ doc.getTitle() }}</a></h3>
                        <div class="text-success small mb-1">{{ doc.getUrl() }}</div>
                        <p class="mb-0">{{ doc.getContent()|default('')|u.truncate(200, '...') }}</p>
                        <span class="badge bg-secondary">{{ doc.getLanguage() }}</span>
                        <span class="badge bg-info">{{ doc.getDomain() }}</span>
                    </div>
                {% else %}
                    <p>Aucun résultat trouvé pour votre recherche.</p>
                {% endfor %}

                {% if results.totalCount > results.limit %}
                    <nav aria-label="Pagination des résultats" class="mt-5">
                        <ul class="pagination justify-content-center">
                            {% set totalPages = (results.totalCount / results.limit)|round(0, 'ceil') %}

                            <li class="page-item {{ currentPage <= 1 ? 'disabled' }}">
                                <a class="page-item page-link" href="{{ path('app_home', {q: query, page: currentPage - 1, filters: activeFilters}) }}">Précédent</a>
                            </li>

                            {% for p in 1..totalPages %}
                                {% if p <= 5 or p > totalPages - 2 or (p >= currentPage - 2 and p <= currentPage + 2) %}
                                    <li class="page-item {{ p == currentPage ? 'active' }}">
                                        <a class="page-link" href="{{ path('app_home', {q: query, page: p, filters: activeFilters}) }}">{{ p }}</a>
                                    </li>
                                {% elseif p == 6 or p == totalPages - 2 %}
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                {% endif %}
                            {% endfor %}

                            <li class="page-item {{ currentPage >= totalPages ? 'disabled' }}">
                                <a class="page-link" href="{{ path('app_home', {q: query, page: currentPage + 1, filters: activeFilters}) }}">Suivant</a>
                            </li>
                        </ul>
                    </nav>
                {% endif %}
            </div>
        </div>
    {% elseif query is not empty %}
         <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <p>Commencez par indexer des données avec <code>php bin/console app:index-sample</code></p>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
